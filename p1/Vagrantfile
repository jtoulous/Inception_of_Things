# -*- mode: ruby -*-
# vi: set ft=ruby :

# p1 - one K3s server (controller) + one K3s agent (worker), set up by Vagrant.
# Provider: VirtualBox (runs nested inside the iot VM).
CONTROL_IP   = "192.168.56.110"
WORKER_IP    = "192.168.56.111"
CONTROL_HOST = "rsterinS"   # K3s server / controller
WORKER_HOST  = "rsterinSW"  # K3s agent  / worker
K3S_TOKEN    = "IvZm4q4OEhd78ObdZS8LJEfqsemGu77KASPg6tWU9E4iab9CCOVuKuZ2ya8PthyA"

Vagrant.configure("2") do |config|
    config.vm.box              = "bento/rockylinux-9"
    config.vm.box_check_update = false
    config.vm.boot_timeout     = 600   # nested VMs boot slowly

    # No shared folder needed (the join token is passed via this file).
    config.vm.synced_folder ".", "/vagrant", disabled: true

    # --- K3s server (controller) ---
    config.vm.define CONTROL_HOST do |s|
        s.vm.hostname = CONTROL_HOST
        s.vm.network "private_network", ip: CONTROL_IP
        s.vm.provision "shell", path: "scripts/server.sh", args: [CONTROL_IP, K3S_TOKEN]

        s.vm.provider "virtualbox" do |vb|
            vb.name   = CONTROL_HOST
            vb.memory = 1024
            vb.cpus   = 1
            # virtio NICs: the default E1000 emulation crashes under nesting.
            vb.customize ["modifyvm", :id, "--nictype1", "virtio", "--nictype2", "virtio"]
            # Plain TSC clock: nested kvmclock destabilizes the guest under load.
            vb.customize ["modifyvm", :id, "--paravirtprovider", "none"]
        end
    end

    # --- K3s agent (worker) ---
    config.vm.define WORKER_HOST do |w|
        w.vm.hostname = WORKER_HOST
        w.vm.network "private_network", ip: WORKER_IP
        w.vm.provision "shell", path: "scripts/worker.sh", args: [CONTROL_IP, WORKER_IP, K3S_TOKEN]

        w.vm.provider "virtualbox" do |vb|
            vb.name   = WORKER_HOST
            vb.memory = 1024
            vb.cpus   = 1
            vb.customize ["modifyvm", :id, "--nictype1", "virtio", "--nictype2", "virtio"]
            vb.customize ["modifyvm", :id, "--paravirtprovider", "none"]
        end
    end
end
